{
  "name": "pb-creative-studio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:all": "npm install && npm install --workspaces",
    "dev:server": "npm run dev --workspace=server",
    "dev:homepage": "npm run dev --workspace=homepage -- --port 5174 --host",
    "dev:downloader": "npm run dev --workspace=downloader -- --port 5173 --host",
    "dev:tools": "npm run dev --workspace=tools -- --port 5175 --host",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:homepage\" \"npm run dev:downloader\" \"npm run dev:tools\"",
    "build": "npm run build --workspaces"
  },
  "workspaces": [
    "apps/*",
    "server"
  ],
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3"
  }
}
