  "redirects": [
    {
      "source": "/:file((?!\\.well-known(?:/.*)?)(?:[^/]+/)*[^/]+\\.\\w+)/",
      "destination": "/:file",
      "internal": true,
      "priority": true,
      "missing": [
        {
          "type": "header",
          "key": "x-nextjs-data"
        }
      ],
      "statusCode": 308,
      "regex": "^(?:/((?!\\.well-known(?:/.*)?)(?:[^/]+/)*[^/]+\\.\\w+))/$"
    },
    {
      "source": "/:notfile((?!\\.well-known(?:/.*)?)(?:[^/]+/)*[^/\\.]+)",
      "destination": "/:notfile/",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?!\\.well-known(?:/.*)?)(?:[^/]+/)*[^/\\.]+))$"
    },
    {
      "source": "/blog/admin/login",
      "destination": "/blog/auth/login",
      "statusCode": 308,
      "regex": "^(?!/_next)/blog/admin/login(?:/)?$"
    },
    {
      "source": "/admin/login",
      "destination": "/blog/auth/login",
      "statusCode": 308,
      "regex": "^(?!/_next)/admin/login(?:/)?$"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.chatwizs.com"
        }
      ],
      "destination": "https://chatwizs.com/:path*",
      "statusCode": 308,
      "regex": "^(?!/_next)(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    }
  ],
