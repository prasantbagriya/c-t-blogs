3:T15cc,{"@context":"https://schema.org","@graph":[{"@type":"WebPage","@id":"https://chatwizs.com/blog/kkr-vs-dc-live-score","url":"https://chatwizs.com/blog/kkr-vs-dc-live-score","name":"KKR vs DC Live Score IPL 2026: Kolkata Knight Riders vs Delhi Capitals – Eden Gardens, May 24","description":"KKR vs DC IPL 2026 Live Score & Updates: Kolkata Knight Riders take on Delhi Capitals at Eden Gardens today at 7:30 PM IST. Get toss result, playing XI, live score, wickets, match prediction & highlights.","inLanguage":"en-IN","isPartOf":{"@id":"https://chatwizs.com/#website"},"primaryImageOfPage":{"@id":"https://chatwizs.com/blog/kkr-vs-dc-live-score#primaryimage"},"breadcrumb":{"@id":"https://chatwizs.com/blog/kkr-vs-dc-live-score#breadcrumb"},"datePublished":"2026-05-24","dateModified":"2026-05-25","speakable":{"@type":"SpeakableSpecification","cssSelector":["h1","#ai-snapshot",".post-content p:first-of-type"]},"audience":{"@type":"Audience","audienceType":"Digital Marketing Professionals, SEO Experts","geographicArea":{"@type":"Country","name":"India"}},"potentialAction":{"@type":"ReadAction","target":"https://chatwizs.com/blog/kkr-vs-dc-live-score"}},{"@type":"BlogPosting","@id":"https://chatwizs.com/blog/kkr-vs-dc-live-score#article","headline":"KKR vs DC Live Score IPL 2026: Kolkata Knight Riders vs Delhi Capitals – Eden Gardens, May 24","name":"KKR vs DC Live Score IPL 2026: Kolkata Knight Riders vs Delhi Capitals – Eden Gardens, May 24","description":"KKR vs DC IPL 2026 Live Score & Updates: Kolkata Knight Riders take on Delhi Capitals at Eden Gardens today at 7:30 PM IST. Get toss result, playing XI, live score, wickets, match prediction & highlights.","datePublished":"2026-05-24","dateModified":"2026-05-25","author":{"@type":"Person","@id":"https://chatwizs.com/#person/kapil-kumar","name":"Kapil Kumar","url":"https://chatwizs.com/author/kapil-kumar","image":"/uploads/media-1779256004256-409405479.jpeg","jobTitle":"Car Review / Automobile Review / Vehicle Analysis