43:["$","p","28",{"children":[["$","span","0",{"style":{"color":"rgb(0, 0, 0)"},"children":"•"}],["$","span","1",{"style":{"color":"rgb(0, 0, 0)","fontSize":"7pt"},"children":"      "}],["$","span","2",{"style":{"color":"rgb(0, 0, 0)"},"children":"It identifies which side of the market to be trading (buy-side or sell-side)"}]]}]
44:["$","p","29",{"children":[["$","span","0",{"style":{"color":"rgb(0, 0, 0)"},"children":"•"}],["$","span","1",{"style":{"color":"rgb(0, 0, 0)","fontSize":"7pt"},"children":"      "}],["$","span","2",{"style":{"color":"rgb(0, 0, 0)"},"children":"Multiple consecutive BOS signals confirm a strong, sustained trend"}]]}]
45:["$","p","30",{"children":[["$","span","0",{"style":{"color":"rgb(0, 0, 0)"},"children":"•"}],["$","span","1",{"style":{"color":"rgb(0, 0, 0)","fontSize":"7pt"},"children":"      "}],["$","span","2",{"style":{"color":"rgb(0, 0, 0)"},"children":"A failed BOS — where price cannot break the previous high/low — is an early warning of potential reversal"}]]}]
46:["$","p","31",{"children":["$","span",null,{"style":{"color":"rgb(0, 0, 0)"},"children":[["$","strong","0",{"children":"Key Insight: "}],"Never trade a BOS in isolation. A BOS near a strong supply or demand zone carries significantly more weight than one occurring in the middle of open price space."]}]}]
47:["$","h1","32",{"children":["$","span",null,{"style":{"color":"rgb(0, 0, 0)"},"children":"3. Change of Character (CHoCH)"}]}]
48:["$","p","33",{"children":["$","span",null,{"style":{"color":"rgb(0, 0, 0)"},"children":"If BOS tells you the trend is continuing, the Change of Character (CHoCH) tells you the trend is ending. CHoCH is the single most important signal in SMC trading because it marks the first moment that the market structure shifts — often before most traders even notice anything has changed."}]}]
49:["$","h2","34",{"id":"h2-bearish-choch-from-uptrend-to-downtrend-4","children":["$","span",null,{"style":{"color":"rgb(0, 0, 0)"},"children":"Bearish CHoCH — From Uptrend to Downtrend"}]}]
4a:["$","p","35",{"children":["$","span",null,{"style":{"color":"rgb(0, 0, 0)"},"children":"During an uptrend, price has been making Higher Highs and Higher Lows. A Bearish CHoCH occurs when price breaks below the most recent Higher Low. This is the first structural sign that the uptrend is losing momentum and a reversal may be underway. Once this break happens, the uptrend structure is broken — what was support (the Higher Low) has now been violated."}]}]
4b:["$","h2","36",{"id":"h2-bullish-choch-from-downtrend-to-uptrend-5","children":["$","span",null,{"style":{"color":"rgb(0, 0, 0)"},"children":"Bullish CHoCH — From Downtrend to Uptrend"}]}]
4c:["$","p","37",{"children":["$","span",null,{"style":{"color":"rgb(0, 0, 0)"},"children":"During a downtrend, price has been making Lower Highs and Lower Lows. A Bullish CHoCH occurs when price breaks above the most recent Lower High. This signals that the downtrend may be reversing and a new uptrend could be starting."}]}]
