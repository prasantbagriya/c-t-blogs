7e:["$","p","87",{"children":[["$","span","0",{"style":{"color":"rgb(0, 0, 0)"},"children":"10."}],["$","span","1",{"style":{"color":"rgb(0, 0, 0)","fontSize":"7pt"},"children":" "}],["$","span","2",{"style":{"color":"rgb(0, 0, 0)"},"children":"Mark the high and low of that candle as your Order Block zone"}]]}]
