89:["$","p","98",{"children":[["$","span","0",{"style":{"color":"rgb(0, 0, 0)"},"children":"15."}],["$","span","1",{"style":{"color":"rgb(0, 0, 0)","fontSize":"7pt"},"children":" "}],["$","span","2",{"style":{"color":"rgb(0, 0, 0)"},"children":"The FVG is the space between Candle 1's high and Candle 3's low (for a bullish FVG) or between Candle 1's low and Candle 3's high (for a bearish FVG)"}]]}]
8a:["$","p","99",{"children":[["$","span","0",{"style":{"color":"rgb(0, 0, 0)"},"children":"16."}],["$","span","1",{"style":{"color":"rgb(0, 0, 0)","fontSize":"7pt"},"children":" "}],["$","span","2",{"style":{"color":"rgb(0, 0, 0)"},"children":"Mark this area with a rectangle on your chart"}]]}]
8b:["$","h2","100",{"id":"h2-bullish-fvg-19","children":["$","span",null,{"style":{"color":"rgb(0, 0, 0)"},"children":"Bullish FVG"}]}]
8c:["$","p","101",{"children":["$","span",null,{"style":{"color":"rgb(0, 0, 0)"},"children":"A Bullish FVG forms after a rapid upward price move. The gap sits below the current price. When price retraces back down into this FVG, it often finds support and bounces upward — giving you a buy entry point."}]}]
8d:["$","h2","102",{"id":"h2-bearish-fvg-20","children":["$","span",null,{"style":{"color":"rgb(0, 0, 0)"},"children":"Bearish FVG"}]}]
8e:["$","p","103",{"children":["$","span",null,{"style":{"color":"rgb(0, 0, 0)"},"children":"A Bearish FVG forms after a rapid downward price move. The gap sits above the current price. When price retraces back up into this FVG, it often encounters resistance and reverses downward — giving you a sell entry point."}]}]
8f:["$","h2","104",{"id":"h2-two-entry-approaches-for-fvg-21","children":["$","span",null,{"style":{"color":"rgb(0, 0, 0)"},"children":"Two Entry Approaches for FVG"}]}]
90:["$","p","105",{"children":[["$","span","0",{"style":{"color":"rgb(0, 0, 0)"},"children":"17."}],["$","span","1",{"style":{"color":"rgb(0, 0, 0)","fontSize":"7pt"},"children":" "}],["$","span","2",{"style":{"color":"rgb(0, 0, 0)"},"children":"Midpoint Entry (Conservative): Wait for price to reach the middle of the FVG before entering. This gives a better confirmation that the zone is holding but risks missing the trade if price reverses early."}]]}]
