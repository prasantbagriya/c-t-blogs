67:["$","p","64",{"children":[["$","span","0",{"style":{"color":"rgb(0, 0, 0)"},"children":"2."}],["$","span","1",{"style":{"color":"rgb(0, 0, 0)","fontSize":"7pt"},"children":"    "}],["$","span","2",{"style":{"color":"rgb(0, 0, 0)"},"children":"Smart Money needs liquidity (sell orders) to fill their own large buy positions. Those retail stop-losses are exactly what they need."}]]}]
