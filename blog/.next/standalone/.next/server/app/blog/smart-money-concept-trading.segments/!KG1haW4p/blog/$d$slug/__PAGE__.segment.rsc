5f:["$","p","56",{"children":[["$","span","0",{"style":{"color":"rgb(0, 0, 0)"},"children":"•"}],["$","span","1",{"style":{"color":"rgb(0, 0, 0)","fontSize":"7pt"},"children":"      "}],["$","span","2",{"style":{"color":"rgb(0, 0, 0)"},"children":"Fresh zones (those that have not been revisited many times) are more powerful"}]]}]
60:["$","p","57",{"children":[["$","span","0",{"style":{"color":"rgb(0, 0, 0)"},"children":"•"}],["$","span","1",{"style":{"color":"rgb(0, 0, 0)","fontSize":"7pt"},"children":"      "}],["$","span","2",{"style":{"color":"rgb(0, 0, 0)"},"children":"The steeper and faster the price left the zone originally, the stronger the zone"}]]}]
61:["$","p","58",{"children":["$","span",null,{"style":{"color":"rgb(0, 0, 0)"},"children":[["$","strong","0",{"children":"Golden Rule: "}],"The higher the timeframe on which you identify a zone, the more reliable it will be. A Daily chart demand zone will hold far more weight than one found on a 5-minute chart."]}]}]
62:["$","h1","59",{"children":["$","span",null,{"style":{"color":"rgb(0, 0, 0)"},"children":"5. Liquidity Grab — The Market's Most Powerful Trick"}]}]
63:["$","p","60",{"children":["$","span",null,{"style":{"color":"rgb(0, 0, 0)"},"children":"The Liquidity Grab is arguably the most eye-opening concept in all of SMC trading. Once you understand it, you will never look at a false breakout the same way again. A liquidity grab is a deliberate manipulation move where Smart Money pushes price beyond a key level — triggering retail stop-losses and breakout orders — before reversing sharply in the opposite direction."}]}]
