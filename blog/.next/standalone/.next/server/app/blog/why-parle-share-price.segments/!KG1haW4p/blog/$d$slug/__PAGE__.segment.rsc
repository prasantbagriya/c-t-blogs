13:["$","p","9",{"children":["$","span",null,{"style":{"color":"rgb(0, 0, 0)","fontSize":"18px"},"children":"However, Parle Products is a privately owned company and is not listed on the stock market. Meanwhile, Parle Industries is a separate listed company with no direct connection to Melody candies. The similar “Parle” name created confusion among retail investors after the viral PM Modi and Meloni moment."}]}]
14:["$","h2","10",{"id":"h2-why-retail-investors-rushed-to-buy-parle-shares-af-2","children":["$","span",null,{"style":{"color":"rgb(0, 0, 0)","fontSize":"18px"},"children":["$","strong",null,{"children":"Why Retail Investors Rushed to Buy Parle Shares After the Viral Clip"}]}]}]
15:["$","p","11",{"children":["$","span",null,{"style":{"color":"rgb(0, 0, 0)","fontSize":"18px"},"children":"As PM Modi gifted the Melody toffee during his meeting with Italy’s PM Giorgia Meloni, the clip quickly became viral on social media. After seeing the trending video, many retail investors started searching for Parle-related stocks and rushed to buy Parle Industries shares. This sudden buzz increased buying activity in the stock market. However, many people later realised that Melody is actually made by Parle Products, which is not a listed company."}]}]
16:["$","h2","12",{"id":"h2-parle-products-and-parle-industries-are-differentn-3","children":["$","span",null,{"style":{"color":"rgb(0, 0, 0)","fontSize":"18px"},"children":["$","strong",null,{"children":"Parle Products and Parle Industries Are Different  Here’s Why the Confusion Happened"}]}]}]
17:["$","p","13",{"children":["$","span",null,{"style":{"color":"rgb(0, 0, 0)","fontSize":"18px"},"children":"After the news came that PM Modi gifted Melody toffee to Giorgia Meloni, everyone started searching about Parle on social media and Google. But the real thing is that many people became confused between Parle Products and Parle Industries. "}]}]
18:["$","p","14",{"children":["$","span",null,{"style":{"color":"rgb(0, 0, 0)","fontSize":"18px"},"children":"Parle Products is the company that actually makes Melody, Parle-G, Mango Bite, and other famous snacks, but it is not listed on the stock market. Meanwhile, Parle Industries is a separate listed company with no direct connection to Melody candies. "}]}]
19:["$","p","15",{"children":["$","span",null,{"style":{"color":"rgb(0, 0, 0)","fontSize":"18px"},"children":"Due to the similar “Parle” name and the viral social media buzz, many retail investors rushed to buy Parle Industries shares, which increased the stock’s attention today."}]}]
