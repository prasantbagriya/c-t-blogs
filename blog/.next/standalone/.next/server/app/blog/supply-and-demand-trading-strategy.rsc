59:["$","p","51",{"children":["$","span",null,{"style":{"color":"rgb(0, 0, 0)"},"children":[["$","strong","0",{"children":"1. Entering without confirmation."}]," Many beginners enter as soon as price touches the zone. Always wait for a confirmation candle that proves the zone is holding."]}]}]
5a:["$","p","52",{"children":["$","span",null,{"style":{"color":"rgb(0, 0, 0)"},"children":[["$","strong","0",{"children":"2. Using zones that are too old."}]," Supply and demand zones lose their power the more times they are tested. After 3–4 tests, a zone is considered consumed and should be discarded."]}]}]
5b:["$","p","53",{"children":["$","span",null,{"style":{"color":"rgb(0, 0, 0)"},"children":[["$","strong","0",{"children":"3. Ignoring higher timeframe zones."}]," Always check the Daily or Weekly chart first. A supply zone on a 4-hour chart is far more powerful when it aligns with a supply zone on the Daily chart."]}]}]
5c:["$","p","54",{"children":["$","span",null,{"style":{"color":"rgb(0, 0, 0)"},"children":[["$","strong","0",{"children":"4. Trading small consolidation candles."}]," Only mark zones created by large, powerful momentum candles. Small candles represent retail noise, not institutional activity."]}]}]
5d:["$","p","55",{"children":["$","span",null,{"style":{"color":"rgb(0, 0, 0)"},"children":[["$","strong","0",{"children":"5. No risk management."}]," Even the best strategy fails without proper risk management. Never risk more than 1–2% of your trading account on a single trade."]}]}]
