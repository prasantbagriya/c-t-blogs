56:["$","p","48",{"children":[["$","span","0",{"style":{"color":"rgb(0, 0, 0)"},"children":"•"}],["$","span","1",{"style":{"color":"rgb(0, 0, 0)","fontSize":"7pt"},"children":"      "}],["$","span","2",{"style":{"color":"rgb(0, 0, 0)"},"children":"Take profit is placed at the next opposing zone"}]]}]
