<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Fix infinite redirect loop caused by physical /blog folder vs Next.js
  DirectorySlash Off
  Options -Indexes

  # Hostinger fix for missing Authorization header
  SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
  SetEnvIf X-Authorization "(.*)" HTTP_X_AUTHORIZATION=$1
  
  RewriteCond %{HTTP:Authorization} ^(.*)
  RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]

  # For Node.js deployments, the Node server handles all routes.
  # We only keep basic env fixes here.
</IfModule>

# Hostinger/Passenger Node.js entrypoint.
# Keep this file at the ZIP root so hPanel/Passenger starts the CommonJS
# wrapper instead of trying to require the ESM app.js directly.
<IfModule mod_passenger.c>
  PassengerAppType node
  PassengerStartupFile server.cjs
</IfModule>

<IfModule passenger_module>
  PassengerAppType node
  PassengerStartupFile server.cjs
</IfModule>

# Basic CORS headers if Apache is intercepting
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, OPTIONS, PUT, DELETE"
    Header set Access-Control-Allow-Headers "Origin, X-Requested-With, Content-Type, Accept, Authorization, X-Authorization"
</IfModule>
