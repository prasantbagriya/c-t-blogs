{
  "name": "chatwizs-ai-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "server.cjs",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node server.cjs",
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\" \"npm run dev:blog\" \"npm run dev:studio\"",
    "dev:client": "vite --port=5173",
    "dev:server": "cross-env PORT=3001 NODE_ENV=development nodemon --config server/nodemon.json server/index.js",
    "dev:blog": "cd blog && npm run dev -- -p 4289",
    "dev:studio": "cd PB-Creative-Studio && npm run dev",
    "build": "echo \"Skip server build\"",
    "build:local": "node generate-sitemap.js && vite build",
    "sitemap": "node generate-sitemap.js",
    "lint": "tsc --noEmit",
    "mobile:sync": "npm run build:local && npx cap sync",
    "mobile:open:android": "npx cap open android",
    "mobile:open:ios": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/ios": "^6.1.2",
    "@capacitor/splash-screen": "^6.0.0",
    "@google/genai": "^1.50.1",
    "@google/generative-ai": "^0.24.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@xyflow/react": "^12.10.1",
    "archiver": "^8.0.0",
    "autoprefixer": "^10.4.21",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.9.0",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^4.22.1",
    "googleapis": "^171.4.0",
    "html2canvas": "^1.4.1",
    "http-proxy-middleware": "^3.0.0",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.14.0",
    "morgan": "^1.10.1",
    "motion": "^12.23.24",
    "multer": "^2.1.1",
    "mysql2": "^3.20.0",
    "nodemailer": "8.0.7",
    "razorpay": "^2.9.6",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.0.0",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.14.2",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.9",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "overrides": {
    "node-domexception": "file:./shims/node-domexception",
    "uuid": "^11.0.0",
    "tar": "^7.4.3",
    "glob": "^11.0.1",
    "minimatch": "^10.0.0"
  }
}
